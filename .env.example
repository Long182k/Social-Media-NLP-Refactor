# Server
PORT=8080
APP_ENV=development
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
STATIC_DIR=

# PostgreSQL (Kiri Compose local)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/social_media?sslmode=disable

# Valkey / Redis (Kiri Compose local)
VALKEY_URL=redis://127.0.0.1:6379/0

# JWT Secrets (REQUIRED — backend fails fast on startup if empty)
JWT_SECRET=
REFRESH_JWT_SECRET=
JWT_TTL=15m
REFRESH_JWT_TTL=168h
COOKIE_SECURE=false

# Rate Limiting
LOGIN_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_LIMIT_DURATION=900s
TRUST_PROXY_HEADERS=false

# Local Mailpit (Milestone 1)
MAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@social-media.local
RESET_TOKEN_TTL=30m

# Hosted demo only, with verified $0 No-Card eligibility
RESEND_API_KEY=
RESEND_OWNER_EMAIL=

# MinIO (provisioned in M1 infra, used in M2 media pipeline)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=social-media-local
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Optional Workers AI refinement (leave blank for local VI/EN scoring)
ENABLE_CLOUD_NLP=false
NLP_CLOUD_EVIDENCE=
NLP_CLOUD_EVALUATION=
NLP_CLOUD_TOKEN=
