{
  "uid": "social-media-api",
  "title": "Social Media API",
  "schemaVersion": 41,
  "tags": [
    "local"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"social-media-api\"}",
          "legendFormat": "API"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[2m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Go heap and process RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "Heap"
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_connections",
          "legendFormat": "Open"
        },
        {
          "refId": "B",
          "expr": "db_pool_acquired_connections",
          "legendFormat": "In use"
        }
      ]
    },
    {
      "id": 6,
      "title": "WebSocket connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "websocket_connections",
          "legendFormat": "Open"
        }
      ]
    },
    {
      "id": 7,
      "title": "Local sentiment p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nlp_local_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "title": "Dropped NLP refinement jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "social-media-victoria"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nlp_refinement_dropped_total",
          "legendFormat": "Dropped"
        }
      ]
    }
  ]
}
